# =============================================================================
# rasp-collector — PRODUCTION environment
# Copy to .env on the VPS (or use alongside docker-compose.prod.yml).
# KEK_MASTER_KEY MUST match rasp/.env.production exactly.
# Collector is reached via Caddy (collector.example.com) or internal network only.
# =============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────

NODE_ENV=production
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# Same value as rasp-platform KEK_MASTER_KEY
KEK_MASTER_KEY="REPLACE-WITH-openssl-rand-base64-32"

# ── RECOMMENDED ───────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

HMAC_REQUIRED=true
# Per-agent HMAC secrets live in DB; optional global fallback:
HMAC_SECRET=""

# Async queue (Redis from docker-compose.prod.yml)
QUEUE_ENABLED=true
REDIS_URL=redis://redis:6379

MAX_EVENT_SIZE_BYTES=65536
RATE_LIMIT_PER_MINUTE=600
ABNORMAL_VOLUME_PER_MINUTE=300

# Leave empty when Caddy terminates TLS in front of the collector
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
MTLS_REQUIRED=false
MTLS_ALLOWED_FINGERPRINTS=
