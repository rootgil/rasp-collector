# =============================================================================
# rasp-collector — DEVELOPMENT environment
# Copy to .env. Never commit .env.
# =============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL — same DB as rasp-platform
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# Redis (BullMQ). REQUIRED for Docker stack / when QUEUE_ENABLED=true.
# Docker Compose: redis://redis:6379
# Host / pnpm: redis://localhost:6379
REDIS_URL=redis://redis:6379
QUEUE_ENABLED=true

# ── OPTIONAL (defaults shown) ─────────────────────────────────────────────────

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

MAX_EVENT_SIZE_BYTES=65536
RATE_LIMIT_PER_MINUTE=600
# Per-agent volume alerting (events+heartbeats/min). Empty uses code default (300).
ABNORMAL_VOLUME_PER_MINUTE=

# HMAC verification (set true in production)
HMAC_REQUIRED=false
HMAC_SECRET=""

# Envelope encryption — MUST match rasp/.env KEK_MASTER_KEY when set.
# Empty = encryption disabled (dev only). Generate: openssl rand -base64 32
KEK_MASTER_KEY=""

# Mutual TLS (optional). See OPERATIONS.md → "mTLS Setup".
MTLS_REQUIRED=false
MTLS_ALLOWED_FINGERPRINTS=

# TLS termination at the collector. Leave empty behind a reverse-proxy (Caddy).
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

LOG_LEVEL=info
