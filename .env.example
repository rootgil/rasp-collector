PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Neon PostgreSQL - same DB as rasp-platform
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# Payload limits
MAX_EVENT_SIZE_BYTES=65536
RATE_LIMIT_PER_MINUTE=600
# Per-agent volume alerting (events+heartbeats/min). Empty = disabled.
ABNORMAL_VOLUME_PER_MINUTE=

# HMAC verification (set to true in production, requires HMAC_SECRET)
HMAC_REQUIRED=false
HMAC_SECRET=""

# Payload encryption at rest (envelope encryption).
# MUST be the SAME base64 value as rasp/.env KEK_MASTER_KEY.
# Generate once with: openssl rand -base64 32
KEK_MASTER_KEY=""

# Mutual TLS (agent client-certificate verification). Optional.
# See OPERATIONS.md → "mTLS Setup" for how to generate certs and fingerprints.
MTLS_REQUIRED=false
# Comma-separated SHA-256 fingerprints of allowed agent client certs (hex, no colons).
# Obtain with: openssl x509 -in agent-cert.pem -outform DER | sha256sum | awk '{print $1}'
MTLS_ALLOWED_FINGERPRINTS=

# TLS termination at the collector (required for real mTLS).
# Leave empty to run plain HTTP behind a TLS-terminating proxy (nginx/traefik).
# See OPERATIONS.md → "TLS Setup".
TLS_CERT_PATH=
TLS_KEY_PATH=
# CA bundle used to verify agent client certs (mTLS only).
TLS_CA_PATH=

LOG_LEVEL=info
